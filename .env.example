# Copy this file to .env and fill in your own values.
# The app reads these via os.environ -- if you use python-dotenv or
# just `export` them in your shell before running, either works.

SECRET_KEY=classof2026
ADMIN_PASSCODE=Luxurytech

# Tier 1 threshold: cosine similarity score (0-1) above which a local
# reference-library match is shown as "confident" instead of falling
# through to tier 2.
SIMILARITY_THRESHOLD=0.75

# Tier 2 (optional): online plant-ID fallback via PlantNet.
# Get a free API key at https://my.plantnet.org/
# Leave blank to skip tier 2 entirely -- the app falls straight from
# tier 1 to manual entry.
PLANTNET_API_KEY=
PLANTNET_PROJECT=all
